// Helper to generate a stage grid
function createStageGrid(cols, rows, groundRow = 10) {
  const grid = [];
  for (let r = 0; r < rows; r++) {
    const row = [];
    for (let c = 0; c < cols; c++) {
      if (r >= groundRow) {
        row.push(1); // Solid ground
      } else {
        row.push(0); // Sky
      }
    }
    grid.push(row);
  }
  return grid;
}

